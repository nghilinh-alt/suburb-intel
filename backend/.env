# Development Database Configuration
# SQLite (default for local dev). Use the aiosqlite driver for async.
DATABASE_URL=sqlite+aiosqlite:///./suburb_intel_dev.db

# Production Database Configuration (PostgreSQL)
# Override DATABASE_URL with this to switch to Postgres:
# DATABASE_URL=postgresql+asyncpg://sa2:census@localhost:5432/suburb_intel

# Domain Group API
# Get your key at developer.domain.com.au → your project → Credentials → Create API Key
# Requires "Properties & Locations" package added to your project.
DOMAIN_API_KEY=key_08639068893ceebe316775568c12272f
