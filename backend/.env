# Development Database Configuration
# For local testing with SQLite:
DATABASE_URL_SQLITE="sqlite:///suburb_intel_dev.db"

# Production Database Configuration (PostgreSQL)
# You'll need PostgreSQL installed locally or on a cloud provider
DATABASE_URL_POSTGRESQL="postgresql+asyncpg://sa2:census@localhost:5432/suburb_intel"

# Default to SQLite for development
DATABASE_URL="${DATABASE_URL_SQLITE}"
